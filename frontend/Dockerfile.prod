# ── Estágio 1: Build da aplicação React com Vite ─────────────────────────────
FROM node:20-alpine AS builder

WORKDIR /app

# Instala dependências primeiro (camada cacheada enquanto package.json não mudar)
COPY package*.json ./
RUN npm ci

# Copia o código-fonte
COPY . .

# Corrige permissões dos binários do node_modules/.bin/ (necessário ao copiar de Windows)
RUN chmod -R +x node_modules/.bin/

# VITE_API_BASE_URL é obrigatório: define para onde o frontend chama a API.
# Passado como build arg pelo deploy.ps1 com a URL do backend Container App.
# Exemplo: https://codecompass-backend.azurecontainerapps.io
ARG VITE_API_BASE_URL
ENV VITE_API_BASE_URL=${VITE_API_BASE_URL}

RUN npm run build

# ── Estágio 2: Servir os assets estáticos com nginx ──────────────────────────
FROM nginx:1.27-alpine

# Copia o build gerado pelo Vite
COPY --from=builder /app/dist /usr/share/nginx/html

# Copia a configuração nginx com SPA fallback e cache headers
COPY nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]

