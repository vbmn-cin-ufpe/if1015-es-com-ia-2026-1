# CodeCompass Backend Environment Configuration

# API Configuration
API_TITLE=CodeCompass API

# Database Configuration
# PostgreSQL connection string (optional, uses in-memory fallback if not set)
# POSTGRES_DSN=postgresql://user:password@localhost:5432/codecompass

# Vector Database Configuration
CHROMA_HOST=localhost
CHROMA_PORT=8001
CHROMA_SSL=false
CHROMA_COLLECTION_PREFIX=codecompass

# Supabase Configuration (optional, for production deployment)
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_ANON_KEY=your-anon-key

# Repository Configuration
ALLOW_LOCAL_REPOS=true
REPO_WORKSPACE=/tmp/codecompass/repos

# Code Chunking Configuration
CHUNK_SIZE=80
CHUNK_OVERLAP=20

# Embedding Configuration
# Model: all-MiniLM-L6-v2 (384 dim), all-mpnet-base-v2 (768 dim), etc.
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_DIM=384

# Embedding provider:
#   local   — sentence-transformers em CPU (padrão, sem chave)
#   abacus  — Abacus AI via proxy OpenAI-compat (~1000 chunks/s, precisa de LLM_API_KEY)
#             Configurar: EMBEDDING_PROVIDER=abacus, EMBEDDING_MODEL=text-embedding-3-small, EMBEDDING_DIM=1536
#   openai  — OpenAI Embeddings API (~1000 chunks/s, precisa de LLM_API_KEY com chave OpenAI)
#             Configurar: EMBEDDING_PROVIDER=openai, EMBEDDING_MODEL=text-embedding-3-small, EMBEDDING_DIM=1536
EMBEDDING_PROVIDER=local

# LLM Configuration (Multi-Provider Support)
# Provider options: "abacus", "anthropic", "openai"
LLM_PROVIDER=abacus

# API Key (get from your provider)
# Abacus AI: https://abacus.ai/
# Anthropic: https://console.anthropic.com/
# OpenAI: https://platform.openai.com/
LLM_API_KEY=your-api-key-here

# API Base URL (optional, for custom endpoints)
# Abacus AI default: https://api.abacus.ai/v1
# Leave empty for default provider URLs
LLM_API_BASE_URL=

# Model Configuration
# Abacus AI models: claude-3-5-sonnet-20240620, gpt-4o, gemini-2.0-flash-exp, etc.
# Anthropic models: claude-sonnet-4-20250514, claude-3-5-sonnet-20241022
# OpenAI models: gpt-4o, gpt-4-turbo, gpt-3.5-turbo
LLM_MODEL=claude-3-5-sonnet-20240620
LLM_MAX_TOKENS=4096
LLM_TEMPERATURE=0.7
