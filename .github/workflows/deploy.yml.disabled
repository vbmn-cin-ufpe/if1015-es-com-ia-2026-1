# ──────────────────────────────────────────────────────────────────────────────
# CodeCompass — CI/CD para Azure Container Apps
#
# Fluxo de ambientes:
#   push na branch dev  → deploy automático em STAGING
#   push na branch main → deploy automático em PROD
#
# PRÉ-REQUISITO: Infraestrutura já criada com Terraform (deploy.ps1 local).
# Este workflow só atualiza as imagens Docker — não recria infra.
#
# GitHub Secrets necessários (Settings → Secrets → Actions):
#   AZURE_CLIENT_ID         — App ID do Service Principal
#   AZURE_TENANT_ID         — Tenant ID do Azure AD
#   AZURE_SUBSCRIPTION_ID   — ID da Subscription Azure
#   ACR_LOGIN_SERVER        — ex: codecompassstagingacr.azurecr.io
#   ACR_USERNAME            — admin username do ACR
#   ACR_PASSWORD            — admin password do ACR
#   STAGING_BACKEND_URL     — URL pública do backend staging (para build do frontend)
#   PROD_BACKEND_URL        — URL pública do backend prod (para build do frontend)
#   STAGING_RESOURCE_GROUP  — ex: codecompass-staging-rg
#   PROD_RESOURCE_GROUP     — ex: codecompass-prod-rg
# ──────────────────────────────────────────────────────────────────────────────

name: Deploy to Azure

on:
  push:
    branches:
      - dev    # → staging
      - main   # → prod
  workflow_dispatch:
    inputs:
      environment:
        description: "Ambiente de deploy"
        required: true
        default: "staging"
        type: choice
        options:
          - staging
          - prod

jobs:
  # ── Determina o ambiente baseado na branch ───────────────────────────────────
  resolve-env:
    runs-on: ubuntu-latest
    outputs:
      environment:   ${{ steps.resolve.outputs.environment }}
      backend_url:   ${{ steps.resolve.outputs.backend_url }}
      resource_group: ${{ steps.resolve.outputs.resource_group }}
    steps:
      - name: Resolve environment
        id: resolve
        run: |
          if [ "${{ github.event_name }}" = "workflow_dispatch" ]; then
            ENV="${{ inputs.environment }}"
          elif [ "${{ github.ref_name }}" = "main" ]; then
            ENV="prod"
          else
            ENV="staging"
          fi

          echo "environment=$ENV" >> $GITHUB_OUTPUT

          if [ "$ENV" = "prod" ]; then
            echo "backend_url=${{ secrets.PROD_BACKEND_URL }}"   >> $GITHUB_OUTPUT
            echo "resource_group=${{ secrets.PROD_RESOURCE_GROUP }}" >> $GITHUB_OUTPUT
          else
            echo "backend_url=${{ secrets.STAGING_BACKEND_URL }}" >> $GITHUB_OUTPUT
            echo "resource_group=${{ secrets.STAGING_RESOURCE_GROUP }}" >> $GITHUB_OUTPUT
          fi

  # ── Build e push das imagens Docker ──────────────────────────────────────────
  build-push:
    needs: resolve-env
    runs-on: ubuntu-latest
    environment: ${{ needs.resolve-env.outputs.environment }}
    outputs:
      image_tag: ${{ steps.meta.outputs.tag }}

    steps:
      - name: Checkout código
        uses: actions/checkout@v4

      - name: Gerar tag da imagem
        id: meta
        run: |
          SHORT_SHA="${{ github.sha }}"
          SHORT_SHA="${SHORT_SHA:0:7}"
          TAG="${{ github.ref_name }}-${SHORT_SHA}"
          echo "tag=$TAG" >> $GITHUB_OUTPUT
          echo "Tag da imagem: $TAG"

      - name: Login no Azure Container Registry
        uses: docker/login-action@v3
        with:
          registry: ${{ secrets.ACR_LOGIN_SERVER }}
          username: ${{ secrets.ACR_USERNAME }}
          password: ${{ secrets.ACR_PASSWORD }}

      - name: Configurar Docker Buildx
        uses: docker/setup-buildx-action@v3

      # ── Backend ───────────────────────────────────────────────────────────────
      - name: Build e push — Backend
        uses: docker/build-push-action@v5
        with:
          context: ./backend
          file: ./backend/Dockerfile
          push: true
          tags: |
            ${{ secrets.ACR_LOGIN_SERVER }}/codecompass-backend:${{ steps.meta.outputs.tag }}
            ${{ secrets.ACR_LOGIN_SERVER }}/codecompass-backend:latest
          cache-from: type=registry,ref=${{ secrets.ACR_LOGIN_SERVER }}/codecompass-backend:cache
          cache-to:   type=registry,ref=${{ secrets.ACR_LOGIN_SERVER }}/codecompass-backend:cache,mode=max

      # ── Frontend (VITE_API_BASE_URL baked em build-time) ─────────────────────
      - name: Build e push — Frontend
        uses: docker/build-push-action@v5
        with:
          context: ./frontend
          file: ./frontend/Dockerfile.prod
          push: true
          build-args: |
            VITE_API_BASE_URL=${{ needs.resolve-env.outputs.backend_url }}
          tags: |
            ${{ secrets.ACR_LOGIN_SERVER }}/codecompass-frontend:${{ steps.meta.outputs.tag }}
            ${{ secrets.ACR_LOGIN_SERVER }}/codecompass-frontend:latest
          cache-from: type=registry,ref=${{ secrets.ACR_LOGIN_SERVER }}/codecompass-frontend:cache
          cache-to:   type=registry,ref=${{ secrets.ACR_LOGIN_SERVER }}/codecompass-frontend:cache,mode=max

  # ── Atualiza Container Apps no Azure ─────────────────────────────────────────
  deploy:
    needs: [resolve-env, build-push]
    runs-on: ubuntu-latest
    environment: ${{ needs.resolve-env.outputs.environment }}

    steps:
      - name: Login no Azure (OIDC — sem segredo que expira)
        uses: azure/login@v2
        with:
          client-id:       ${{ secrets.AZURE_CLIENT_ID }}
          tenant-id:       ${{ secrets.AZURE_TENANT_ID }}
          subscription-id: ${{ secrets.AZURE_SUBSCRIPTION_ID }}

      - name: Atualizar Container App — Backend
        run: |
          RG="${{ needs.resolve-env.outputs.resource_group }}"
          ENV="${{ needs.resolve-env.outputs.environment }}"
          TAG="${{ needs.build-push.outputs.image_tag }}"
          IMAGE="${{ secrets.ACR_LOGIN_SERVER }}/codecompass-backend:${TAG}"

          # Descobre o nome do container app pelo resource group
          APP=$(az containerapp list --resource-group "$RG" \
            --query "[?contains(name,'backend')].name" -o tsv)

          echo "Atualizando $APP com imagem $IMAGE"
          az containerapp update \
            --name "$APP" \
            --resource-group "$RG" \
            --image "$IMAGE"

      - name: Atualizar Container App — Frontend
        run: |
          RG="${{ needs.resolve-env.outputs.resource_group }}"
          TAG="${{ needs.build-push.outputs.image_tag }}"
          IMAGE="${{ secrets.ACR_LOGIN_SERVER }}/codecompass-frontend:${TAG}"

          APP=$(az containerapp list --resource-group "$RG" \
            --query "[?contains(name,'frontend')].name" -o tsv)

          echo "Atualizando $APP com imagem $IMAGE"
          az containerapp update \
            --name "$APP" \
            --resource-group "$RG" \
            --image "$IMAGE"

      - name: Resumo do deploy
        run: |
          ENV="${{ needs.resolve-env.outputs.environment }}"
          RG="${{ needs.resolve-env.outputs.resource_group }}"
          TAG="${{ needs.build-push.outputs.image_tag }}"

          FRONTEND_URL=$(az containerapp list --resource-group "$RG" \
            --query "[?contains(name,'frontend')].properties.configuration.ingress.fqdn" -o tsv)
          BACKEND_URL=$(az containerapp list --resource-group "$RG" \
            --query "[?contains(name,'backend')].properties.configuration.ingress.fqdn" -o tsv)

          echo "## Deploy concluído ✅" >> $GITHUB_STEP_SUMMARY
          echo "" >> $GITHUB_STEP_SUMMARY
          echo "| | |" >> $GITHUB_STEP_SUMMARY
          echo "|---|---|" >> $GITHUB_STEP_SUMMARY
          echo "| **Ambiente** | $ENV |" >> $GITHUB_STEP_SUMMARY
          echo "| **Tag** | $TAG |" >> $GITHUB_STEP_SUMMARY
          echo "| **Frontend** | https://$FRONTEND_URL |" >> $GITHUB_STEP_SUMMARY
          echo "| **Backend** | https://$BACKEND_URL |" >> $GITHUB_STEP_SUMMARY
          echo "| **Swagger** | https://$BACKEND_URL/docs |" >> $GITHUB_STEP_SUMMARY
