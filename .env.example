# ============================================================
# CodeCompass — Arquivo de exemplo de variáveis de ambiente
# Copie este arquivo para .env e preencha com seus valores.
# O arquivo .env NUNCA deve ser versionado (ver .gitignore).
# ============================================================

# ── LLM ─────────────────────────────────────────────────────
# Provider: "abacus" | "openai" | "anthropic"
LLM_PROVIDER=abacus

# Chave de API do provider LLM (obrigatória)
# Abacus AI: https://abacus.ai/
# OpenAI:    https://platform.openai.com/
# Anthropic: https://console.anthropic.com/
LLM_API_KEY=your-llm-api-key-here

# Modelo a usar (exemplos)
# Abacus:    CLAUDE_V3_5_SONNET | CLAUDE_V4_5_SONNET | GPT4_O
# OpenAI:    gpt-4o | gpt-4-turbo
# Anthropic: claude-3-5-sonnet-20241022
LLM_MODEL=CLAUDE_V3_5_SONNET

# ── Embeddings ───────────────────────────────────────────────
# Provider: "local" (CPU, sem chave) | "openai" (rápido, precisa OPENAI_API_KEY)
EMBEDDING_PROVIDER=local

# Chave OpenAI exclusiva para embeddings (se EMBEDDING_PROVIDER=openai)
OPENAI_API_KEY=your-openai-api-key-here

# Modelo e dimensão dos embeddings
# local:  all-MiniLM-L6-v2 / dim=384
# openai: text-embedding-3-small / dim=1536
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_DIM=384

# Workers paralelos para embeddings OpenAI (ignorado no modo local)
EMBEDDING_MAX_WORKERS=4

# ── PostgreSQL ───────────────────────────────────────────────
POSTGRES_DB=codecompass
POSTGRES_USER=codecompass
POSTGRES_PASSWORD=change_me_strong_password

# ── Admin inicial ────────────────────────────────────────────
# Usuário criado automaticamente no primeiro startup
ADMIN_EMAIL=admin
ADMIN_PASSWORD=change_me_strong_password
