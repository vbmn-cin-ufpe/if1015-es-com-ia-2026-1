# ============================================================
# CodeCompass — Arquivo de exemplo de variáveis de ambiente
# Copie este arquivo para .env e preencha com seus valores.
# O arquivo .env NUNCA deve ser versionado (ver .gitignore).
# ============================================================

# ── LLM ─────────────────────────────────────────────────────
# Provider: "abacus" | "openai" | "anthropic"
LLM_PROVIDER=abacus

# Chave de API do provider LLM (obrigatória)
# Abacus AI: https://abacus.ai/
# OpenAI:    https://platform.openai.com/
# Anthropic: https://console.anthropic.com/
LLM_API_KEY=your-llm-api-key-here

# Modelo a usar (exemplos)
# Abacus:    CLAUDE_V3_5_SONNET | CLAUDE_V4_5_SONNET | GPT4_O
# OpenAI:    gpt-4o | gpt-4-turbo
# Anthropic: claude-3-5-sonnet-20241022
LLM_MODEL=CLAUDE_V3_5_SONNET

# ── Embeddings ───────────────────────────────────────────────
# Provider: "local" (CPU, sem chave) | "openai" (rápido, precisa OPENAI_API_KEY)
EMBEDDING_PROVIDER=local

# Chave OpenAI exclusiva para embeddings (se EMBEDDING_PROVIDER=openai)
OPENAI_API_KEY=your-openai-api-key-here

# Modelo e dimensão dos embeddings
# local:  all-MiniLM-L6-v2 / dim=384
# openai: text-embedding-3-small / dim=1536
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_DIM=384

# Workers paralelos para embeddings OpenAI (ignorado no modo local)
EMBEDDING_MAX_WORKERS=4

# ── PostgreSQL ───────────────────────────────────────────────
POSTGRES_DB=codecompass
POSTGRES_USER=codecompass
POSTGRES_PASSWORD=change_me_strong_password

# ── Admin inicial ────────────────────────────────────────────
# Usuário criado automaticamente no primeiro startup
ADMIN_EMAIL=admin@codecompass.dev
ADMIN_PASSWORD=change_me_strong_password

# ── JWT ──────────────────────────────────────────────────────
# Segredo para assinar tokens JWT (mude para uma string longa aleatória em produção)
# Gere com: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=change-me-use-a-very-long-random-string-in-production
JWT_EXPIRY_HOURS=24

# URL pública do frontend (usada nos links de e-mail)
APP_BASE_URL=http://localhost:5173

# ── Azure Communication Services — E-mail ────────────────────
# Deixe em branco em dev — os e-mails serão impressos no log do backend
# Em produção: cole a connection string do recurso no portal Azure
AZURE_EMAIL_CONNECTION_STRING=
AZURE_EMAIL_FROM=donotreply@codecompass.dev
