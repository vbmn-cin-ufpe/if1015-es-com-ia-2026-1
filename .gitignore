# ── Terraform ─────────────────────────────────────────────────────────────────

# Arquivos de variáveis com segredos — NUNCA subir para o git
infra/envs/staging.tfvars
infra/envs/prod.tfvars
infra/terraform.tfvars
infra/**/*.tfvars
# Exceção: o arquivo de exemplo (sem valores reais) DEVE ir para o git
!infra/envs/staging.tfvars.example
!infra/envs/prod.tfvars.example
!infra/terraform.tfvars.example

# Estado local do Terraform (contém valores de outputs, inclusive segredos)
infra/.terraform/
infra/.terraform.lock.hcl
infra/terraform.tfstate
infra/terraform.tfstate.backup
infra/terraform.tfstate.d/
infra/tfplan

# Arquivos de override locais
infra/override.tf
infra/override.tf.json
infra/*_override.tf
infra/*_override.tf.json
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/sdks
!.yarn/versions

# Vite logs files
vite.config.js.timestamp-*
vite.config.ts.timestamp-*

.history/

